{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "node"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "void/db": ["./.void/db.d.ts"],
      "void/routes": ["./.void/routes.d.ts"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"]
    }
  },
  "include": ["src", "pages", "routes", "middleware", "crons", "queues", "db", "scripts"]
}
